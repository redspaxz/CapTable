# Shared-hosting layout (cPanel): the whole repository is deployed inside
# the web root. Application internals are forbidden; every other request
# is served from public/.

RewriteEngine On

# Never serve application internals or metadata
RewriteRule ^(app|config|database)(/|$) - [F]
RewriteRule (^|/)\.git(/|$) - [F]
RewriteRule (^|/)\.env$ - [F]
RewriteRule (^|/)\.cpanel\.yml$ - [F]

# Everything else — including the bare directory index — goes through
# public/. No -f/-d conditions: a -d skip would break "/ctms/" because
# the repository root itself has no index file.
RewriteRule ^(.*)$ public/$1 [L]
